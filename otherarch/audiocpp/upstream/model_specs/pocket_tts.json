  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "tokenizer": "model:tokenizer.model"
      },
      "optional_files": {
        "config": "model:config.yaml"
      },
      "tensors": {
        "weights": "weights:"
      }
    },
    {
