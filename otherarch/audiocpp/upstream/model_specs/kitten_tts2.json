      "files": {
        "config": "model:config.json",
        "lm_config": "model:lm/config.json",
        "tokenizer_config": "model:lm/tokenizer_config.json",
        "tokenizer_json": "model:lm/tokenizer.json",
        "default_voices": "model:cpp/default/voices.json"
